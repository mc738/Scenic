<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Core\Domain.fs"/>
        <Compile Include="Core\EditorContext.fs"/>
        <Compile Include="Core\Input.fs" />
        <Compile Include="Components\Debugging\DebugPlane.fs" />
        <Compile Include="Components\Viewport3D.fs" />
        <Folder Include="Controls\" />
        <Compile Include="Views\SceneEditor.fs" />
        <Compile Include="MainWindow.axaml.fs"/>
        <Compile Include="App.axaml.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0"/>
        <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.0"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Silk.NET" Version="2.23.0"/>
        <PackageReference Include="StbImageSharp" Version="2.30.16"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\FsToolbox\FsToolbox.GameDevelopment\FsToolbox.GameDevelopment.fsproj" />
      <ProjectReference Include="..\..\..\FsToolbox\FsToolbox.OpenGL\FsToolbox.OpenGL.fsproj" />
    </ItemGroup>
</Project>
